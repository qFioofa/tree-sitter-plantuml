{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "plantuml",
      "camelcase": "Plantuml",
      "scope": "source.plantuml",
      "path": ".",
      "file-types": [
        "puml",
        "iuml",
        "plantuml",
        "wsd",
        "pu"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm",
      "folds": "queries/folds.scm",
      "indents": "queries/indents.scm",
      "textobjects": "queries/textobjects.scm",
      "context": "queries/context.scm",
      "rainbow": "queries/rainbow.scm"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "PlantUML grammar for tree-sitter",
    "authors": [
      {
        "name": "qFioofa",
        "email": "penavana1@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/qFioofa/tree-sitter-plantuml"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
